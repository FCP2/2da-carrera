<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title><%= title %></title>


  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  >


  <link
    rel="stylesheet"
    href="/css/app.css"
  >

</head>


<body
  class="
    min-h-screen
    bg-marfil
    text-texto
  "
>


  <!-- ========================= -->
  <!-- HEADER -->
  <!-- ========================= -->

  <header
    class="
      sticky
      top-0
      z-40
      border-b
      border-linea/70
      bg-marfil/90
      backdrop-blur-xl
    "
  >

    <div
      class="
        mx-auto
        flex
        h-20
        max-w-7xl
        items-center
        justify-between
        px-6
        lg:px-8
      "
    >

      <a
        href="/"
        class="block"
      >

        <p
          class="
            text-[10px]
            font-bold
            uppercase
            tracking-[0.18em]
            text-naranja
          "
        >
          Segunda Carrera Atlética
        </p>


        <p
          class="
            mt-0.5
            font-extrabold
            tracking-tight
            text-guinda-dark
          "
        >
          “Voces que Corren” 5 km
        </p>

      </a>


      <a
        href="/"
        class="
          inline-flex
          items-center
          gap-2
          rounded-xl
          border
          border-linea
          bg-white
          px-4
          py-2.5
          text-xs
          font-semibold
          text-guinda
          shadow-sm
          transition
          hover:border-guinda/20
          hover:bg-marfil
        "
      >

        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>

        Volver

      </a>

    </div>

  </header>



  <main>


    <!-- ========================= -->
    <!-- HERO -->
    <!-- ========================= -->

    <section
      class="
        relative
        overflow-hidden
        border-b
        border-linea/70
      "
    >


      <div
        class="
          pointer-events-none
          absolute
          -left-32
          -top-32
          h-96
          w-96
          rounded-full
          bg-dorado-soft/25
          blur-3xl
        "
      ></div>


      <div
        class="
          pointer-events-none
          absolute
          -right-28
          top-0
          h-96
          w-96
          rounded-full
          bg-naranja/10
          blur-3xl
        "
      ></div>


      <div
        class="
          relative
          mx-auto
          max-w-7xl
          px-6
          py-16
          lg:px-8
          lg:py-24
        "
      >


        <div
          class="
            max-w-4xl
          "
        >


          <div
            class="
              inline-flex
              items-center
              gap-2.5
              rounded-full
              border
              border-dorado-soft
              bg-white/70
              px-4
              py-2
              text-xs
              font-semibold
              text-guinda
              shadow-sm
              backdrop-blur
            "
          >

            <span
              class="
                flex
                h-6
                w-6
                items-center
                justify-center
                rounded-full
                bg-naranja-soft
                text-naranja
              "
            >

              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-3.5 w-3.5"
              >
                <rect
                  x="3"
                  y="5"
                  width="18"
                  height="14"
                  rx="2"
                ></rect>

                <circle
                  cx="9"
                  cy="10"
                  r="2"
                ></circle>

                <path
                  d="m21 15-5-5L5 19"
                ></path>
              </svg>

            </span>

            Memoria fotográfica

          </div>



          <h1
            class="
              mt-7
              max-w-4xl
              text-5xl
              font-extrabold
              tracking-[-0.05em]
              text-guinda-dark
              sm:text-6xl
              lg:text-7xl
            "
          >
            Momentos que
            <span class="text-naranja">
              también corren.
            </span>
          </h1>



          <p
            class="
              mt-7
              max-w-2xl
              text-justify
              text-base
              leading-7
              text-texto-soft
              sm:text-lg
            "
          >
            Un recorrido visual por la Segunda Carrera Atlética
            “Voces que Corren” 5 km, a través de imágenes que
            documentan la participación, convivencia y experiencias
            vividas durante el evento.
          </p>



          <!-- DATOS EVENTO -->

          <div
            class="
              mt-10
              flex
              flex-wrap
              items-center
              gap-x-10
              gap-y-6
            "
          >


            <div>

              <strong
                class="
                  block
                  text-3xl
                  font-extrabold
                  tracking-tight
                  text-guinda-dark
                "
              >
                <%= totalPhotos.toLocaleString('es-MX') %>
              </strong>

              <span
                class="
                  mt-1
                  block
                  text-[11px]
                  font-semibold
                  uppercase
                  tracking-[0.13em]
                  text-texto-soft
                "
              >
                Fotografías
              </span>

            </div>



            <div
              class="
                hidden
                h-12
                w-px
                bg-linea
                sm:block
              "
            ></div>



            <div>

              <strong
                class="
                  block
                  text-lg
                  font-bold
                  text-guinda-dark
                "
              >
                25 de octubre de 2026
              </strong>

              <span
                class="
                  mt-1
                  block
                  text-[11px]
                  font-semibold
                  uppercase
                  tracking-[0.13em]
                  text-texto-soft
                "
              >
                Valle de Chalco Solidaridad
              </span>

            </div>


          </div>

        </div>

      </div>

    </section>



    <!-- ========================= -->
    <!-- FILTROS -->
    <!-- ========================= -->

    <% if (photos.length > 0) { %>

      <section
        class="
          sticky
          top-20
          z-30
          border-b
          border-linea/70
          bg-marfil/90
          backdrop-blur-xl
        "
      >

        <div
          class="
            mx-auto
            max-w-7xl
            px-6
            py-4
            lg:px-8
          "
        >

          <div
            id="galleryFilters"
            class="
              flex
              gap-2
              overflow-x-auto
              pb-1
            "
          >


            <button
              type="button"
              data-filter="all"
              class="
                gallery-filter
                shrink-0
                rounded-full
                bg-guinda
                px-5
                py-2.5
                text-xs
                font-semibold
                text-white
                shadow-sm
                transition
              "
            >
              Todas
            </button>



            <button
              type="button"
              data-filter="salida"
              class="
                gallery-filter
                shrink-0
                rounded-full
                border
                border-linea
                bg-white
                px-5
                py-2.5
                text-xs
                font-semibold
                text-texto-soft
                transition
                hover:border-guinda/20
                hover:text-guinda
              "
            >
              Salida
            </button>



            <button
              type="button"
              data-filter="recorrido"
              class="
                gallery-filter
                shrink-0
                rounded-full
                border
                border-linea
                bg-white
                px-5
                py-2.5
                text-xs
                font-semibold
                text-texto-soft
                transition
                hover:border-guinda/20
                hover:text-guinda
              "
            >
              Recorrido
            </button>



            <button
              type="button"
              data-filter="meta"
              class="
                gallery-filter
                shrink-0
                rounded-full
                border
                border-linea
                bg-white
                px-5
                py-2.5
                text-xs
                font-semibold
                text-texto-soft
                transition
                hover:border-guinda/20
                hover:text-guinda
              "
            >
              Meta
            </button>



            <button
              type="button"
              data-filter="convivencia"
              class="
                gallery-filter
                shrink-0
                rounded-full
                border
                border-linea
                bg-white
                px-5
                py-2.5
                text-xs
                font-semibold
                text-texto-soft
                transition
                hover:border-guinda/20
                hover:text-guinda
              "
            >
              Convivencia
            </button>



            <button
              type="button"
              data-filter="institucional"
              class="
                gallery-filter
                shrink-0
                rounded-full
                border
                border-linea
                bg-white
                px-5
                py-2.5
                text-xs
                font-semibold
                text-texto-soft
                transition
                hover:border-guinda/20
                hover:text-guinda
              "
            >
              Institucional
            </button>


          </div>

        </div>

      </section>

    <% } %>



    <!-- ========================= -->
    <!-- GALERÍA -->
    <!-- ========================= -->

    <section
      class="
        mx-auto
        max-w-7xl
        px-6
        py-12
        lg:px-8
        lg:py-16
      "
    >


      <% if (photos.length > 0) { %>


        <div
          class="
            mb-8
            flex
            flex-col
            gap-2
            sm:flex-row
            sm:items-end
            sm:justify-between
          "
        >

          <div>

            <p
              class="
                text-xs
                font-bold
                uppercase
                tracking-[0.15em]
                text-naranja
              "
            >
              Voces que Corren
            </p>

            <h2
              class="
                mt-2
                text-3xl
                font-extrabold
                tracking-tight
                text-guinda-dark
              "
            >
              Galería del evento
            </h2>

          </div>


          <p
            id="visiblePhotoCount"
            class="
              text-sm
              text-texto-soft
            "
          >
            Mostrando
            <strong class="text-guinda-dark">
              <%= totalPhotos %>
            </strong>
            fotografías
          </p>

        </div>



        <div
          id="galleryGrid"
          class="
            columns-1
            gap-5
            sm:columns-2
            lg:columns-3
            xl:columns-4
          "
        >


          <% photos.forEach((photo, index) => { %>


            <article
              tabindex="0"
              role="button"

              class="
                gallery-item
                group
                relative
                mb-5
                break-inside-avoid
                cursor-zoom-in
                overflow-hidden
                rounded-[1.5rem]
                bg-white
                shadow-sm
                ring-1
                ring-black/5
                transition
                duration-300
                hover:-translate-y-1
                hover:shadow-xl
                hover:shadow-guinda/10
                focus:outline-none
                focus:ring-4
                focus:ring-guinda/10
              "

              data-category="<%= photo.category %>"
              data-image="<%= photo.src %>"
              data-title="<%= photo.title %>"
            >


              <img
                src="<%= photo.src %>"
                alt="<%= photo.title %>"
                loading="<%= index < 4 ? 'eager' : 'lazy' %>"

                class="
                  h-auto
                  w-full
                  transition
                  duration-700
                  ease-out
                  group-hover:scale-[1.035]
                "
              >



              <!-- Overlay -->

              <div
                class="
                  absolute
                  inset-0
                  bg-gradient-to-t
                  from-black/75
                  via-black/5
                  to-transparent
                  opacity-0
                  transition
                  duration-300
                  group-hover:opacity-100
                "
              ></div>



              <!-- Información -->

              <div
                class="
                  absolute
                  inset-x-0
                  bottom-0
                  translate-y-3
                  p-5
                  opacity-0
                  transition
                  duration-300
                  group-hover:translate-y-0
                  group-hover:opacity-100
                "
              >

                <span
                  class="
                    inline-flex
                    rounded-full
                    bg-white/15
                    px-2.5
                    py-1
                    text-[10px]
                    font-bold
                    uppercase
                    tracking-wider
                    text-white/80
                    backdrop-blur
                  "
                >
                  <%= photo.category %>
                </span>


                <p
                  class="
                    mt-2
                    text-sm
                    font-semibold
                    leading-5
                    text-white
                  "
                >
                  <%= photo.title %>
                </p>

              </div>



              <!-- Icono -->

              <div
                class="
                  absolute
                  right-4
                  top-4
                  flex
                  h-9
                  w-9
                  translate-y-1
                  items-center
                  justify-center
                  rounded-full
                  bg-black/30
                  text-white
                  opacity-0
                  backdrop-blur
                  transition
                  duration-300
                  group-hover:translate-y-0
                  group-hover:opacity-100
                "
              >

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-4 w-4"
                >
                  <circle
                    cx="11"
                    cy="11"
                    r="7"
                  ></circle>

                  <path
                    d="m20 20-3.5-3.5"
                  ></path>

                  <path
                    d="M11 8v6M8 11h6"
                  ></path>
                </svg>

              </div>


            </article>


          <% }) %>


        </div>



        <!-- SIN RESULTADOS POR FILTRO -->

        <div
          id="galleryEmptyFilter"
          class="
            hidden
            py-16
            text-center
          "
        >

          <p
            class="
              text-sm
              text-texto-soft
            "
          >
            No hay fotografías disponibles
            en esta categoría.
          </p>

        </div>


      <% } else { %>


        <!-- ========================= -->
        <!-- ESTADO VACÍO -->
        <!-- ========================= -->

        <div
          class="
            relative
            overflow-hidden
            rounded-[2rem]
            border
            border-linea
            bg-white
            px-6
            py-20
            text-center
            shadow-xl
            shadow-guinda/5
          "
        >


          <div
            class="
              pointer-events-none
              absolute
              -right-20
              -top-20
              h-56
              w-56
              rounded-full
              bg-naranja-soft
              blur-3xl
            "
          ></div>


          <div
            class="
              relative
              mx-auto
              flex
              h-16
              w-16
              items-center
              justify-center
              rounded-2xl
              bg-guinda
              text-white
              shadow-lg
              shadow-guinda/15
            "
          >

            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-7 w-7"
            >

              <rect
                x="3"
                y="5"
                width="18"
                height="14"
                rx="2"
              ></rect>

              <circle
                cx="9"
                cy="10"
                r="2"
              ></circle>

              <path
                d="m21 15-5-5L5 19"
              ></path>

            </svg>

          </div>


          <p
            class="
              mt-6
              text-xs
              font-bold
              uppercase
              tracking-[0.15em]
              text-naranja
            "
          >
            Memoria fotográfica
          </p>


          <h2
            class="
              mt-3
              text-3xl
              font-extrabold
              tracking-tight
              text-guinda-dark
            "
          >
            La galería estará disponible próximamente
          </h2>


          <p
            class="
              mx-auto
              mt-4
              max-w-lg
              text-sm
              leading-6
              text-texto-soft
            "
          >
            Después de la carrera publicaremos en este espacio
            una selección de imágenes que documentarán los
            principales momentos y actividades del evento.
          </p>


          <a
            href="/"
            class="
              mt-8
              inline-flex
              items-center
              justify-center
              rounded-2xl
              bg-guinda
              px-6
              py-3.5
              text-sm
              font-semibold
              text-white
              transition
              hover:bg-guinda-dark
            "
          >
            Volver al inicio
          </a>


        </div>


      <% } %>


    </section>

  </main>



  <!-- ========================= -->
  <!-- LIGHTBOX -->
  <!-- ========================= -->

  <div
    id="galleryLightbox"

    class="
      fixed
      inset-0
      z-50
      hidden
      items-center
      justify-center
      bg-black/90
      p-4
      backdrop-blur-md
    "
  >


    <button
      id="closeLightbox"
      type="button"

      aria-label="Cerrar fotografía"

      class="
        absolute
        right-5
        top-5
        z-10
        flex
        h-11
        w-11
        items-center
        justify-center
        rounded-full
        bg-white/10
        text-white
        backdrop-blur
        transition
        hover:bg-white/20
      "
    >

      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        class="h-5 w-5"
      >
        <path d="M6 6l12 12"></path>
        <path d="M18 6 6 18"></path>
      </svg>

    </button>



    <button
      id="previousPhoto"
      type="button"

      aria-label="Fotografía anterior"

      class="
        absolute
        left-3
        top-1/2
        z-10
        hidden
        h-12
        w-12
        -translate-y-1/2
        items-center
        justify-center
        rounded-full
        bg-white/10
        text-white
        backdrop-blur
        transition
        hover:bg-white/20
        sm:flex
      "
    >

      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5"
      >
        <path d="m15 18-6-6 6-6"></path>
      </svg>

    </button>



    <button
      id="nextPhoto"
      type="button"

      aria-label="Siguiente fotografía"

      class="
        absolute
        right-3
        top-1/2
        z-10
        hidden
        h-12
        w-12
        -translate-y-1/2
        items-center
        justify-center
        rounded-full
        bg-white/10
        text-white
        backdrop-blur
        transition
        hover:bg-white/20
        sm:flex
      "
    >

      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5"
      >
        <path d="m9 18 6-6-6-6"></path>
      </svg>

    </button>



    <div
      class="
        flex
        max-h-[92vh]
        w-full
        max-w-6xl
        flex-col
        items-center
        justify-center
      "
    >

      <img
        id="lightboxImage"
        src=""
        alt=""

        class="
          max-h-[80vh]
          max-w-full
          rounded-2xl
          object-contain
          shadow-2xl
        "
      >


      <div
        class="
          mt-4
          text-center
        "
      >

        <p
          id="lightboxTitle"
          class="
            text-sm
            font-medium
            text-white
          "
        ></p>


        <p
          id="lightboxCounter"
          class="
            mt-1
            text-xs
            text-white/45
          "
        ></p>

      </div>

    </div>

  </div>



  <script src="/js/gallery.js"></script>

</body>

</html>
