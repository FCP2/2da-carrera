  <dialog id="indicaciones-kit" class="kit-slides" aria-labelledby="indicaciones-kit-titulo">
    <div class="kit-slides__layout">
      <header class="kit-slides__header">
        <div>
          <p class="kit-slides__eyebrow">Información para participantes</p>
          <h2 id="indicaciones-kit-titulo" class="kit-slides__title">Entrega del kit de carrera</h2>
        </div>
        <button type="button" class="kit-slides__close" id="cerrar-indicaciones-kit" aria-label="Cerrar indicaciones">&times;</button>
      </header>
      <div class="kit-slides__stage">
        <figure class="kit-slides__image-wrap" id="indicaciones-imagen-scroll">
          <img
            id="imagen-indicaciones-kit"
            class="kit-slides__image"
            src="/assets/1_post.jpg"
            alt="Entrega del paquete: 23 y 24 de octubre, de 9:00 a 17:00 horas, en la explanada municipal de Valle de Chalco Solidaridad. Lleva identificación oficial y carta responsiva firmada."
            width="1440"
            height="1800"
            fetchpriority="high"
          >
        </figure>
        <nav class="kit-slides__controls" aria-label="Navegación de indicaciones">
          <button type="button" class="kit-slides__button" id="indicaciones-anterior" aria-label="Imagen anterior" disabled>
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <span class="kit-slides__position" id="indicaciones-posicion" aria-live="polite">1 de 3</span>
          <button type="button" class="kit-slides__button" id="indicaciones-siguiente" aria-label="Imagen siguiente">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </nav>
      </div>
    </div>
  </dialog>

  <script>
    (() => {
      const dialog = document.getElementById('indicaciones-kit');
      const image = document.getElementById('imagen-indicaciones-kit');
      const imageScroll = document.getElementById('indicaciones-imagen-scroll');
      const previous = document.getElementById('indicaciones-anterior');
      const next = document.getElementById('indicaciones-siguiente');
      const position = document.getElementById('indicaciones-posicion');
      const slides = [
        {
          src: '/assets/1_post.jpg',
          alt: 'Entrega del paquete: 23 y 24 de octubre, de 9:00 a 17:00 horas, en la explanada municipal de Valle de Chalco Solidaridad. Lleva identificación oficial y carta responsiva firmada.'
        },
        {
          src: '/assets/2_post.jpg',
          alt: 'Al recoger tu paquete muestra el código QR que llegó a tu correo. Puedes presentarlo desde tu celular o impreso.'
        },
        {
          src: '/assets/3_post.webp',
          alt: 'Si no puedes recoger tu kit, otra persona puede hacerlo por ti. Debe presentar tu código QR, tu identificación oficial digital y tu carta responsiva en físico, requisitada y firmada.'
        }
      ];
      let current = 0;

      function showSlide(index) {
        current = index;
        image.src = slides[index].src;
        image.alt = slides[index].alt;
        imageScroll.scrollTop = 0;
        position.textContent = `${index + 1} de ${slides.length}`;
        previous.disabled = index === 0;
        next.disabled = index === slides.length - 1;
      }

      function openSlides() {
        showSlide(0);
        if (!dialog.open) dialog.showModal();
      }

      document.getElementById('abrir-indicaciones-kit').addEventListener('click', openSlides);
      document.getElementById('cerrar-indicaciones-kit').addEventListener('click', () => dialog.close());
      previous.addEventListener('click', () => showSlide(current - 1));
      next.addEventListener('click', () => showSlide(current + 1));
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight' && current < slides.length - 1) showSlide(current + 1);
        if (event.key === 'ArrowLeft' && current > 0) showSlide(current - 1);
      });

      document.addEventListener('DOMContentLoaded', openSlides, { once: true });
    })();
  </script>
