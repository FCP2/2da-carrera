  <style>
    .kit-slides {
      width: min(600px, calc(100vw - 24px));
      height: min(92dvh, calc(125vw + 160px), 920px);
      max-width: none;
      max-height: none;
      margin: auto;
      padding: 0;
      border: 0;
      border-radius: 20px;
      overflow: hidden;
      background: #fff;
      color: #32242b;
      box-shadow: 0 24px 80px rgba(29, 15, 22, .35);
    }
    .kit-slides::backdrop {
      background: rgba(29, 15, 22, .72);
      backdrop-filter: blur(4px);
    }
    .kit-slides__layout {
      display: flex;
      flex-direction: column;
      height: 100%;
    }
    .kit-slides__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 16px;
    }
    .kit-slides__header {
      background: #682039;
      color: #fff;
    }
    .kit-slides__eyebrow {
      margin: 0 0 2px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      opacity: .75;
    }
    .kit-slides__title {
      margin: 0;
      font-size: 15px;
      font-weight: 800;
      line-height: 1.3;
    }
    .kit-slides__close {
      display: grid;
      flex: none;
      place-items: center;
      width: 36px;
      height: 36px;
      border: 1px solid rgba(255, 255, 255, .3);
      border-radius: 50%;
      background: rgba(255, 255, 255, .12);
      color: #fff;
      font-size: 22px;
      line-height: 1;
      cursor: pointer;
    }
    .kit-slides__stage {
      position: relative;
      flex: 1;
      min-height: 0;
      padding-bottom: 70px;
      background: #f9eef2;
    }
    .kit-slides__image-wrap {
      height: 100%;
      margin: 0;
      padding: 8px;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-gutter: stable;
    }
    .kit-slides__image {
      display: block;
      width: 100%;
      height: auto;
      margin: 0 auto;
    }
    .kit-slides__controls {
      position: absolute;
      bottom: 13px;
      left: 50%;
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 5px;
      transform: translateX(-50%);
      border: 1px solid rgba(140, 38, 65, .15);
      border-radius: 999px;
      background: rgba(255, 255, 255, .88);
      box-shadow: 0 8px 30px rgba(71, 26, 43, .16);
      backdrop-filter: blur(10px);
    }
    .kit-slides__button {
      display: grid;
      place-items: center;
      width: 38px;
      height: 38px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: transparent;
      color: #8c2641;
      cursor: pointer;
      transition: background .2s ease, color .2s ease;
    }
    .kit-slides__button:not(:disabled):hover {
      background: #8c2641;
      color: #fff;
    }
    .kit-slides__button:disabled {
      opacity: .35;
      cursor: default;
    }
    .kit-slides__button:focus-visible,
    .kit-slides__close:focus-visible {
      outline: 3px solid #d49aaa;
      outline-offset: 2px;
    }
    .kit-slides__position {
      color: #682039;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }
    @media (max-width: 420px) {
      .kit-slides__header { padding: 10px 12px; }
      .kit-slides__title { font-size: 13px; }
    }
  </style>
</head>

