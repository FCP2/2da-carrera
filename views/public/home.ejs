<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="Voces que Corren. Carrera conmemorativa en el marco del Día Naranja."
  >

  <title><%= title %></title>

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="/css/app.css"
  >
</head>

<body class="min-h-screen bg-marfil text-texto">

  <!-- NAVBAR -->
  <header
    class="
      sticky
      top-0
      z-50
      border-b
      border-linea/80
      bg-marfil/85
      backdrop-blur-xl
    "
  >

    <div
      class="
        mx-auto
        flex
        h-20
        max-w-7xl
        items-center
        justify-between
        px-6
        lg:px-8
      "
    >

    <a
      href="/"
      class="
        flex
        items-center
      "
    >

      <div>
        <p
          class="
            text-[11px]
            font-bold
            uppercase
            tracking-[0.14em]
            text-naranja
          "
        >
          Segunda Carrera Atlética
        </p>

        <p
          class="
            mt-0.5
            text-base
            font-extrabold
            tracking-tight
            text-guinda-dark
            sm:text-lg
          "
        >
          “Voces que Corren” 5 km
        </p>

        <p
          class="
            mt-0.5
            text-xs
            font-medium
            text-texto-soft
          "
        >
          Por una vida libre de violencia
        </p>

      </div>

    </a>


      <div
        class="
          hidden
          items-center
          gap-3
          sm:flex
        "
      >

        <span
          class="
            inline-flex
            items-center
            gap-2
            rounded-full
            border
            border-white/40
            bg-white/25
            px-4
            py-2
            text-xs
            font-semibold
            text-guinda-dark
            shadow-lg
            shadow-guinda/10
            ring-1
            ring-white/30
            backdrop-blur-xl
          "
        >

          <span
            class="
              h-2
              w-2
              rounded-full
              bg-naranja
            "
          ></span>

          25 N

        </span>

      </div>

    </div>

  </header>


  <!-- HERO -->
  <main>

    <section
      class="
        relative
        overflow-hidden
      "
    >

      <!-- decoración -->
      <div
        class="
          pointer-events-none
          absolute
          -left-20
          top-16
          h-72
          w-72
          rounded-full
          bg-dorado-soft/25
          blur-3xl
        "
      ></div>

      <div
        class="
          pointer-events-none
          absolute
          -right-24
          top-24
          h-80
          w-80
          rounded-full
          bg-naranja/10
          blur-3xl
        "
      ></div>


      <div
        class="
          relative
          mx-auto
          grid
          min-h-[calc(100vh-80px)]
          max-w-7xl
          items-center
          gap-14
          px-6
          py-16
          lg:grid-cols-[1.1fr_.9fr]
          lg:px-8
          lg:py-20
        "
      >

        <!-- contenido -->
        <div>

          <div
            class="
              mb-7
              inline-flex
              items-center
              gap-3
              rounded-2xl
              border
              border-guinda/10
              bg-white/80
              px-3
              py-3
              shadow-sm
              backdrop-blur-xl
              transition
              duration-300
              hover:-translate-y-0.5
              hover:shadow-md
            "
          >

            <!-- Fecha -->
            <div
              class="
                flex
                h-11
                w-11
                shrink-0
                items-center
                justify-center
                rounded-xl
                bg-guinda
                text-center
                text-white
                shadow-sm
              "
            >
              <div class="leading-none">
                <span
                  class="
                    block
                    text-[10px]
                    font-semibold
                    uppercase
                    tracking-wider
                    text-dorado-soft
                  "
                >
                  OCT
                </span>

                <strong
                  class="
                    block
                    text-lg
                    font-extrabold
                  "
                >
                  25
                </strong>
              </div>
            </div>


            <!-- Información -->
            <div class="pr-2">

              <p
                class="
                  text-xs
                  font-semibold
                  uppercase
                  tracking-[0.12em]
                  text-texto-soft
                "
              >
                Domingo
              </p>

              <div
                class="
                  mt-0.5
                  flex
                  flex-wrap
                  items-center
                  gap-2
                  text-sm
                  font-semibold
                  text-guinda-dark
                "
              >

                <span>
                  25 de octubre de 2026
                </span>

                <span
                  class="
                    h-1
                    w-1
                    rounded-full
                    bg-dorado
                  "
                ></span>

                <span>
                  9:00 a. m.
                </span>

              </div>

            </div>

          </div>



          <div class="max-w-3xl">
            <img
              src="/img/voces_que_corren.png"
              alt="Voces que Corren"
              class="
                w-full
                max-w-2xl
                object-contain
                drop-shadow-[0_20px_35px_rgba(111,29,58,0.12)]
              "
            >
          </div>
          <div
            class="
              mt-9
              max-w-2xl
              rounded-3xl
              border
              border-dorado-soft/60
              bg-white/75
              p-6
              shadow-lg
              shadow-guinda/5
              backdrop-blur
              sm:p-7
            "
          >

            <div
              class="
                flex
                items-start
                gap-4
              "
            >

              <div
                class="
                  flex
                  h-10
                  w-10
                  shrink-0
                  items-center
                  justify-center
                  rounded-2xl
                  bg-naranja-soft
                  text-naranja
                "
              >

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-5 w-5"
                >
                  <path d="M6 3h9l3 3v15H6z"></path>
                  <path d="M15 3v4h4"></path>
                  <path d="M9 11h6"></path>
                  <path d="M9 15h6"></path>
                </svg>

              </div>


              <div class="min-w-0">

                <p
                  class="
                    mt-3
                    text-justify
                    text-base
                    leading-7
                    text-texto-soft
                    sm:text-lg
                    sm:leading-8
                  "
                >
                  En el marco del
                  <strong class="font-semibold text-guinda-dark">
                    Día Internacional de la Eliminación de la Violencia contra las Mujeres
                  </strong>,
                  que se conmemora cada
                  <strong class="font-semibold text-naranja">
                    25 de noviembre
                  </strong>,
                  esta iniciativa busca promover espacios de participación,
                  convivencia y bienestar a través del deporte, así como fortalecer
                  los valores de respeto, igualdad, inclusión y solidaridad.
                </p>

              </div>

            </div>

          </div>
          <div
            class="
              mt-10
              flex
              flex-wrap
              items-center
              gap-4
            "
          >

          <a
            href="/registro"
            id="btn-registro"
            class="
              relative
              overflow-hidden
              inline-flex
              items-center
              justify-center
              rounded-2xl
              bg-guinda
              px-6
              py-3.5
              text-sm
              font-semibold
              text-white
              shadow-lg
              shadow-guinda/15
              transition-all
              duration-300
              hover:-translate-y-0.5
              hover:bg-guinda-dark
              hover:shadow-xl
              group
            "
            onclick="iniciarCarga(event, this)"
          >
            <!-- Efecto 3: Capa para el brillo metálico -->
            <span class="absolute top-0 -left-[50%] w-[30%] h-full bg-gradient-to-r from-transparent via-white/30 to-transparent -skew-x-25 transition-none group-hover:animate-shine"></span>

            <!-- Texto del botón -->
            <span id="texto-boton">Iniciar registro</span>

            <!-- Contenedor del Icono (Efecto 1 y 2) -->
            <span id="contenedor-icono" class="ml-2 inline-flex items-center justify-center w-4 h-4 transition-transform duration-300 group-hover:translate-x-1">
              <!-- Icono de flecha nativo -->
              <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </span>
          </a>

            
            <a
              href="/galeria"
              class="
                inline-flex
                items-center
                gap-2
                rounded-2xl
                border
                border-linea
                bg-white/80
                px-4
                py-2.5
                text-sm
                font-semibold
                text-guinda
                shadow-sm
                transition
                hover:-translate-y-0.5
                hover:border-guinda/20
                hover:bg-white
                hover:shadow-md
              "
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-4 w-4"
              >
                <rect
                  x="3"
                  y="5"
                  width="18"
                  height="14"
                  rx="2"
                ></rect>

                <circle
                  cx="9"
                  cy="10"
                  r="2"
                ></circle>

                <path
                  d="m21 15-5-5L5 19"
                ></path>
              </svg>

              Galería
            </a>


            <a
              href="#informacion"
              class="
                inline-flex
                items-center
                justify-center
                rounded-2xl
                border
                border-guinda/15
                bg-white/70
                px-6
                py-3.5
                text-sm
                font-semibold
                text-guinda
                shadow-sm
                backdrop-blur-xl
                transition
                duration-200
                hover:-translate-y-0.5
                hover:bg-white
              "
            >
              Conocer más
            </a>

          </div>


          <div
            class="
              mt-14
              grid
              gap-4
              sm:grid-cols-2
              lg:grid-cols-3
            "
          >

            <article
              class="
                rounded-3xl
                border
                border-linea
                bg-white/70
                p-5
                shadow-sm
                backdrop-blur-xl
              "
            >

              <p
                class="
                  text-xs
                  font-semibold
                  uppercase
                  tracking-wider
                  text-texto-soft
                "
              >
                Capacidad
              </p>

              <strong
                class="
                  mt-2
                  block
                  text-3xl
                  font-bold
                  tracking-tight
                  text-guinda-dark
                "
              >
                <%= capacity.toLocaleString('es-MX') %>
              </strong>

              <p
                class="
                  mt-1
                  text-sm
                  text-texto-soft
                "
              >
                participantes
              </p>

            </article>


            <!-- KPI de confirmados oculto temporalmente; para habilitarlo, elimina la clase hidden. -->
            <article
              id="kpi-confirmados"
              class="
                hidden
                rounded-3xl
                border
                border-linea
                bg-white/70
                p-5
                shadow-sm
                backdrop-blur-xl
              "
            >

              <p
                class="
                  text-xs
                  font-semibold
                  uppercase
                  tracking-wider
                  text-texto-soft
                "
              >
                Confirmados
              </p>

              <strong
                class="
                  mt-2
                  block
                  text-3xl
                  font-bold
                  tracking-tight
                  text-guinda-dark
                "
              >
                <%= confirmed.toLocaleString('es-MX') %>
              </strong>

              <p
                class="
                  mt-1
                  text-sm
                  text-texto-soft
                "
              >
                registros
              </p>

            </article>

          </div>

        </div>


        <!-- CARD LATERAL -->
        <aside
          id="registro"
          class="
            relative
          "
        >

          <div
            class="
              absolute
              -inset-5
              -z-10
              rounded-[2.5rem]
              bg-gradient-to-br
              from-guinda/8
              via-dorado-soft/18
              to-naranja/8
              blur-2xl
            "
          ></div>


          <div
            class="
              overflow-hidden
              rounded-[2rem]
              border
              border-white/80
              bg-white/85
              shadow-2xl
              shadow-guinda/10
              backdrop-blur-xl
            "
          >

            <div
              class="
                border-b
                border-linea
                bg-gradient-to-r
                from-guinda
                to-guinda-dark
                px-7
                py-6
                text-white
              "
            >

              <div
                class="
                  flex
                  items-start
                  justify-between
                  gap-4
                "
              >

                <div>

                  <p
                    class="
                      text-xs
                      font-semibold
                      uppercase
                      tracking-[0.16em]
                      text-dorado-soft
                    "
                  >
                    Voces que Corren
                  </p>

                  <h2
                    class="
                      mt-2
                      text-2xl
                      font-bold
                      tracking-tight
                    "
                  >
                    Tu lugar comienza aquí
                  </h2>

                </div>


                <div
                  class="
                    flex
                    h-11
                    w-11
                    shrink-0
                    items-center
                    justify-center
                    rounded-2xl
                    bg-white/10
                    text-lg
                    backdrop-blur
                  "
                >
                  25
                </div>

              </div>

            </div>


            <div
              class="
                p-7
              "
            >

              <p
                class="
                  text-sm
                  leading-6
                  text-texto-soft
                "
              >
                Completa tu preregistro y recibirás un correo electrónico
                para confirmar tu inscripción.
              </p>


              <div
                class="
                  mt-7
                  space-y-4
                "
              >

                <div
                  class="
                    flex
                    items-start
                    gap-4
                    rounded-2xl
                    border
                    border-linea
                    bg-marfil
                    p-4
                  "
                >

                  <div
                    class="
                      flex
                      h-9
                      w-9
                      shrink-0
                      items-center
                      justify-center
                      rounded-xl
                      bg-guinda
                      text-sm
                      font-bold
                      text-white
                    "
                  >
                    1
                  </div>

                  <div>

                    <strong
                      class="
                        block
                        text-sm
                        font-semibold
                        text-guinda-dark
                      "
                    >
                      Completa tus datos
                    </strong>

                    <p
                      class="
                        mt-1
                        text-sm
                        leading-5
                        text-texto-soft
                      "
                    >
                      El registro será rápido y completamente en línea.
                    </p>

                  </div>

                </div>


                <div
                  class="
                    flex
                    items-start
                    gap-4
                    rounded-2xl
                    border
                    border-linea
                    bg-marfil
                    p-4
                  "
                >

                  <div
                    class="
                      flex
                      h-9
                      w-9
                      shrink-0
                      items-center
                      justify-center
                      rounded-xl
                      bg-dorado
                      text-sm
                      font-bold
                      text-white
                    "
                  >
                    2
                  </div>

                  <div>

                    <strong
                      class="
                        block
                        text-sm
                        font-semibold
                        text-guinda-dark
                      "
                    >
                      Confirma tu correo
                    </strong>

                    <p
                      class="
                        mt-1
                        text-sm
                        leading-5
                        text-texto-soft
                      "
                    >
                      Te enviaremos un enlace personal y seguro.
                    </p>

                  </div>

                </div>


                <div
                  class="
                    flex
                    items-start
                    gap-4
                    rounded-2xl
                    border
                    border-naranja/15
                    bg-naranja-soft
                    p-4
                  "
                >

                  <div
                    class="
                      flex
                      h-9
                      w-9
                      shrink-0
                      items-center
                      justify-center
                      rounded-xl
                      bg-naranja
                      text-sm
                      font-bold
                      text-white
                    "
                  >
                    3
                  </div>

                  <div>

                    <strong
                      class="
                        block
                        text-sm
                        font-semibold
                        text-guinda-dark
                      "
                    >
                      Recibe tu folio
                    </strong>

                    <p
                      class="
                        mt-1
                        text-sm
                        leading-5
                        text-texto-soft
                      "
                    >
                      Tu lugar se reservará al confirmar tu inscripción.
                    </p>

                  </div>

                </div>

              </div>


              <a
                href="/registro"
                class="
                  mt-7
                  flex
                  w-full
                  items-center
                  justify-center
                  rounded-2xl
                  bg-guinda
                  px-5
                  py-4
                  text-sm
                  font-semibold
                  text-white
                  shadow-lg
                  shadow-guinda/15
                  transition
                  duration-200
                  hover:-translate-y-0.5
                  hover:bg-guinda-dark
                "
              >
                Comenzar preregistro
                <span class="ml-2">→</span>
              </a>


              <div
                class="
                  mt-5
                  flex
                  items-center
                  justify-center
                  gap-2
                  text-xs
                  text-texto-soft
                "
              >

              </div>

            </div>

          </div>

        </aside>

      </div>

    </section>


    <!-- FRANJA INSTITUCIONAL -->
    <section
      id="informacion"
      class="
        border-y
        border-linea
        bg-white/60
      "
    >

      <div
        class="
          mx-auto
          grid
          max-w-7xl
          gap-8
          px-6
          py-12
          md:grid-cols-3
          lg:px-8
        "
      >

        <div>

          <p
            class="
              text-xs
              font-bold
              uppercase
              tracking-[0.16em]
              text-guinda
            "
          >
            Institucional
          </p>

          <h3
            class="
              mt-2
              text-xl
              font-bold
              tracking-tight
              text-guinda-dark
            "
          >
            Una experiencia con propósito
          </h3>

        </div>
        <p
          class="
            text-sm
            leading-6
            text-texto-soft
          "
        >
          Después del evento, este mismo sitio continuará como espacio
          de consulta, memoria y galería fotográfica de la carrera.
        </p>

      </div>

    </section>

  </main>


  <!-- FOOTER -->
  <footer
    class="
      bg-guinda-dark
      text-white
    "
  >
    <div
      class="
        mx-auto
        flex
        max-w-7xl
        flex-col
        gap-3
        px-6
        py-3
        text-sm
        md:flex-row
        md:items-center
        lg:px-8
      "
    >

      <!-- LOGOS -->
      <div
        class="
          flex
          shrink-0
          items-center
          justify-center
          gap-4
          sm:justify-start
        "
      >

        <img
          src="/img/logos_edomex.png"
          alt="Gobierno del Estado de México"
          class="
            h-8
            w-auto
            object-contain
            sm:h-9
          "
        >

        <div
          class="
            h-8
            w-px
            bg-white/20
            sm:h-9
          "
        ></div>

        <img
          src="/img/valle_de_chalco.png"
          alt="Municipio de Valle de Chalco"
          class="
            h-16
            w-auto
            max-w-[130px]
            object-contain
            sm:h-18
            sm:max-w-[145px]
          "
        >

      </div>


      <!-- LEYENDA -->
      <p
        class="
          w-full
          text-center
          text-xs
          leading-5
          text-dorado-soft
          md:ml-auto
          md:max-w-[430px]
          md:text-right
          lg:max-w-[460px]
        "
      >
        25 de noviembre · Día Internacional de la Eliminación
        de la Violencia contra las Mujeres
      </p>

    </div>
    <div
      class="
        border-t
        border-white/10
        px-6
        py-2.5
        text-center
        text-[11px]
        leading-5
        text-white/45
      "
    >
      <span class="font-medium text-white/60">
        @desarrollador by
        <strong class="font-semibold text-dorado-soft">
          FranViG
        </strong>
      </span>

      <span class="mx-1.5 text-white/20">
        ·
      </span>

      <span>
        Soporte técnico
        <a
          href="mailto:francisco.vicencio.mx@gmail.com"
          class="
            transition
            hover:text-dorado-soft
          "
        >
          francisco.vicencio.mx@gmail.com
        </a>
      </span>

      <span class="mx-1.5 text-white/20">
        |
      </span>

      <span>
        Subsecretaría General de Gobierno del Estado de México
      </span>
    </div>
  </footer>

</body>
</html>
