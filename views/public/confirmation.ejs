<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title><%= title %></title>

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="/css/app.css"
  >
</head>


<body class="min-h-screen bg-marfil text-texto">

  <main
    class="
      relative
      min-h-screen
      overflow-hidden
    "
  >

    <!-- Decoración -->
    <div
      class="
        pointer-events-none
        absolute
        -left-24
        top-10
        h-80
        w-80
        rounded-full
        bg-dorado-soft/20
        blur-3xl
      "
    ></div>

    <div
      class="
        pointer-events-none
        absolute
        -right-24
        top-32
        h-96
        w-96
        rounded-full
        bg-naranja/10
        blur-3xl
      "
    ></div>


    <!-- HEADER -->
    <header
      class="
        relative
        z-10
        border-b
        border-linea/70
        bg-marfil/80
        backdrop-blur-xl
      "
    >

      <div
        class="
          mx-auto
          flex
          h-20
          max-w-7xl
          items-center
          justify-between
          px-6
          lg:px-8
        "
      >

        <a href="/" class="block">

          <p
            class="
              text-[11px]
              font-bold
              uppercase
              tracking-[0.16em]
              text-naranja
            "
          >
            Segunda Carrera Atlética
          </p>

          <p
            class="
              mt-0.5
              text-base
              font-extrabold
              tracking-tight
              text-guinda-dark
              sm:text-lg
            "
          >
            “Voces que Corren” 5 km
          </p>

        </a>


        <span
          class="
            hidden
            rounded-full
            border
            border-guinda/10
            bg-white/70
            px-4
            py-2
            text-xs
            font-semibold
            text-guinda
            shadow-sm
            sm:inline-flex
          "
        >
          Registro oficial
        </span>

      </div>

    </header>


    <section
      class="
        relative
        z-10
        mx-auto
        max-w-7xl
        px-6
        py-12
        lg:px-8
        lg:py-16
      "
    >

      <% if (success) { %>

        <!-- ESTADO -->
        <div
          class="
            mx-auto
            max-w-4xl
            text-center
          "
        >

        <div
          class="
            mx-auto
            flex
            h-16
            w-16
            items-center
            justify-center
            rounded-2xl
            bg-guinda
            text-white
            shadow-lg
            shadow-guinda/15
          "
        >

          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-8 w-8"
            aria-hidden="true"
          >
            <!-- mensaje -->
            <path
              d="M8 18H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5"
            />

            <path
              d="M3 7l9 6 9-6"
            />

            <!-- círculo de confirmación -->
            <circle
              cx="17"
              cy="17"
              r="4"
              fill="#6F1D3A"
            />

            <!-- palomita -->
            <path
              d="m15.5 17 1 1 2-2"
              stroke="white"
              stroke-width="1.8"
            />
          </svg>

        </div>


          <p
            class="
              mt-6
              text-xs
              font-bold
              uppercase
              tracking-[0.18em]
              text-naranja
            "
          >
            Registro confirmado
          </p>


          <h1
            class="
              mt-3
              text-4xl
              font-extrabold
              tracking-[-0.04em]
              text-guinda-dark
              sm:text-5xl
            "
          >

            <% if (alreadyConfirmed) { %>
              Tu inscripción ya estaba confirmada
            <% } else { %>
              Ya eres parte de Voces que Corren
            <% } %>

          </h1>


          <p
            class="
              mx-auto
              mt-5
              max-w-2xl
              text-base
              leading-7
              text-texto-soft
            "
          >
            <strong class="font-semibold text-guinda-dark">
              <%= data.nombre %>
            </strong>,
            tu inscripción ha quedado confirmada correctamente.
            Conserva tu folio para futuras consultas relacionadas
            con el evento.
          </p>

        </div>


        <!-- CONTENIDO PRINCIPAL -->
        <div
          class="
            mx-auto
            mt-12
            grid
            max-w-5xl
            gap-6
            lg:grid-cols-[1.15fr_.85fr]
          "
        >

          <!-- FOLIO -->
          <article
            class="
              relative
              overflow-hidden
              rounded-[2rem]
              bg-guinda-dark
              p-8
              text-white
              shadow-2xl
              shadow-guinda/15
              sm:p-10
            "
          >

            <div
              class="
                absolute
                -right-16
                -top-16
                h-48
                w-48
                rounded-full
                border
                border-white/10
              "
            ></div>

            <div
              class="
                absolute
                -right-6
                top-10
                h-32
                w-32
                rounded-full
                border
                border-dorado-soft/20
              "
            ></div>


            <div class="relative z-10">

              <p
                class="
                  text-xs
                  font-semibold
                  uppercase
                  tracking-[0.18em]
                  text-dorado-soft
                "
              >
                Folio de participante
              </p>


              <div
                class="
                  mt-6
                  flex
                  flex-wrap
                  items-end
                  gap-3
                "
              >

                <strong
                  class="
                    text-5xl
                    font-extrabold
                    tracking-[-0.04em]
                    sm:text-6xl
                  "
                >
                  <%= data.folio %>
                </strong>

              </div>


              <div
                class="
                  mt-8
                  grid
                  gap-4
                  border-t
                  border-white/10
                  pt-6
                  sm:grid-cols-2
                "
              >

                <div>

                  <p
                    class="
                      text-xs
                      uppercase
                      tracking-wider
                      text-white/50
                    "
                  >
                    Evento
                  </p>

                  <p
                    class="
                      mt-1
                      text-sm
                      font-semibold
                      text-white
                    "
                  >
                    <%= data.evento %>
                  </p>

                </div>


                <div>

                  <p
                    class="
                      text-xs
                      uppercase
                      tracking-wider
                      text-white/50
                    "
                  >
                    Estatus
                  </p>

                  <div
                    id="confirmationStatus"
                    class="
                      mt-3
                      flex
                      items-center
                      gap-3
                    "
                  >

                    <div
                      class="
                        relative
                        flex
                        h-10
                        w-10
                        shrink-0
                        items-center
                        justify-center
                      "
                    >

                      <span
                        id="statusPulse"
                        class="
                          absolute
                          h-10
                          w-10
                          rounded-full
                          bg-emerald-400/20
                          opacity-0
                        "
                      ></span>

                      <span
                        class="
                          relative
                          flex
                          h-8
                          w-8
                          items-center
                          justify-center
                          rounded-full
                          bg-emerald-400/15
                          ring-1
                          ring-emerald-300/30
                        "
                      >

                        <svg
                          id="statusCheck"
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.4"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="
                            h-4
                            w-4
                            scale-50
                            text-emerald-300
                            opacity-0
                            transition
                            duration-500
                          "
                        >
                          <path d="m5 12 4 4L19 6" />
                        </svg>

                      </span>

                    </div>


                    <div>

                      <strong
                        id="statusText"
                        class="
                          block
                          text-sm
                          font-semibold
                          text-white
                          opacity-0
                          transition
                          duration-500
                        "
                      >
                        Inscripción confirmada
                      </strong>

                      <span
                        id="statusSubtext"
                        class="
                          mt-0.5
                          block
                          text-xs
                          text-white/45
                          opacity-0
                          transition
                          duration-500
                        "
                      >
                        Tu lugar ha sido reservado
                      </span>

                    </div>

                  </div>

                </div>

              </div>

            </div>

          </article>


          <!-- SIGUIENTE PASO -->
          <aside
            class="
              rounded-[2rem]
              border
              border-linea
              bg-white/85
              p-7
              shadow-xl
              shadow-guinda/5
              backdrop-blur-xl
            "
          >

            <p
              class="
                text-xs
                font-bold
                uppercase
                tracking-[0.16em]
                text-dorado
              "
            >
              Lo que sigue
            </p>


            <h2
              class="
                mt-3
                text-2xl
                font-bold
                tracking-tight
                text-guinda-dark
              "
            >
              Guarda tu información
            </h2>


            <div
              class="
                mt-6
                space-y-5
              "
            >

              <div
                class="
                  flex
                  gap-4
                "
              >

                <div
                  class="
                    flex
                    h-9
                    w-9
                    shrink-0
                    items-center
                    justify-center
                    rounded-xl
                    bg-guinda/8
                    text-sm
                    font-bold
                    text-guinda
                  "
                >
                  1
                </div>

                <div>

                  <strong
                    class="
                      block
                      text-sm
                      text-guinda-dark
                    "
                  >
                    Conserva tu folio
                  </strong>

                  <p
                    class="
                      mt-1
                      text-sm
                      leading-6
                      text-texto-soft
                    "
                  >
                    Lo utilizarás para identificar tu inscripción.
                  </p>

                </div>

              </div>


              <div
                class="
                  flex
                  gap-4
                "
              >

                <div
                  class="
                    flex
                    h-9
                    w-9
                    shrink-0
                    items-center
                    justify-center
                    rounded-xl
                    bg-dorado-pale
                    text-sm
                    font-bold
                    text-guinda
                  "
                >
                  2
                </div>

                <div>

                  <strong
                    class="
                      block
                      text-sm
                      text-guinda-dark
                    "
                  >
                    Revisa tu correo electrónico
                  </strong>

                  <p
                    class="
                      mt-1
                      text-sm
                      leading-6
                      text-texto-soft
                    "
                  >
                    Recibirás información importante sobre la carrera.
                  </p>

                </div>

              </div>


              <div
                class="
                  flex
                  gap-4
                "
              >

                <div
                  class="
                    flex
                    h-9
                    w-9
                    shrink-0
                    items-center
                    justify-center
                    rounded-xl
                    bg-naranja-soft
                    text-sm
                    font-bold
                    text-naranja
                  "
                >
                  3
                </div>

                <div>

                  <strong
                    class="
                      block
                      text-sm
                      text-guinda-dark
                    "
                  >
                    Próximamente: QR
                  </strong>

                  <p
                    class="
                      mt-1
                      text-sm
                      leading-6
                      text-texto-soft
                    "
                  >
                    Tu código QR estará disponible para control de
                    participante y entrega de kit.
                  </p>

                </div>

              </div>

            </div>

          </aside>

        </div>


        <!-- ACCIONES -->
        <div
          class="
            mx-auto
            mt-8
            flex
            max-w-5xl
            flex-col
            gap-3
            sm:flex-row
            sm:justify-between
          "
        >

          <a
            href="/"
            class="
              inline-flex
              items-center
              justify-center
              rounded-2xl
              border
              border-linea
              bg-white/80
              px-6
              py-3.5
              text-sm
              font-semibold
              text-guinda
              transition
              hover:bg-white
            "
          >
            ← Volver al inicio
          </a>


          <button
            type="button"
            onclick="window.print()"
            class="
              inline-flex
              items-center
              justify-center
              rounded-2xl
              bg-guinda
              px-6
              py-3.5
              text-sm
              font-semibold
              text-white
              shadow-lg
              shadow-guinda/10
              transition
              hover:-translate-y-0.5
              hover:bg-guinda-dark
            "
          >
            Guardar comprobante
          </button>

        </div>


        <!-- MENSAJE INSTITUCIONAL -->
        <div
          class="
            mx-auto
            mt-10
            max-w-5xl
            rounded-2xl
            border
            border-naranja/15
            bg-naranja-soft/70
            px-6
            py-5
            text-center
          "
        >

          <p
            class="
              text-sm
              leading-6
              text-texto-soft
            "
          >
            Gracias por formar parte de una iniciativa que promueve
            la convivencia, la participación y una vida libre de violencia.
          </p>

        </div>


      <% } else { %>

        <!-- ERROR -->
        <div
          class="
            mx-auto
            max-w-xl
            rounded-[2rem]
            border
            border-linea
            bg-white/90
            p-8
            text-center
            shadow-xl
            shadow-guinda/5
            backdrop-blur-xl
          "
        >

          <div
            class="
              mx-auto
              flex
              h-14
              w-14
              items-center
              justify-center
              rounded-2xl
              bg-naranja-soft
              text-xl
              font-bold
              text-naranja
            "
          >
            !
          </div>


          <p
            class="
              mt-6
              text-xs
              font-bold
              uppercase
              tracking-[0.16em]
              text-naranja
            "
          >
            Confirmación no disponible
          </p>


          <h1
            class="
              mt-2
              text-3xl
              font-extrabold
              tracking-tight
              text-guinda-dark
            "
          >
            No pudimos completar la confirmación
          </h1>


          <p
            class="
              mt-4
              text-sm
              leading-6
              text-texto-soft
            "
          >
            <%= errorMessage %>
          </p>


          <% if (errorCode === 'TOKEN_EXPIRED') { %>

            <div
              class="
                mt-6
                rounded-2xl
                border
                border-naranja/15
                bg-naranja-soft
                p-4
                text-sm
                leading-6
                text-texto-soft
              "
            >
              Tu preregistro permanece almacenado.
              Podrás solicitar un nuevo enlace de confirmación.
            </div>

          <% } %>


          <a
            href="/"
            class="
              mt-7
              inline-flex
              rounded-2xl
              bg-guinda
              px-6
              py-3
              text-sm
              font-semibold
              text-white
              transition
              hover:bg-guinda-dark
            "
          >
            Volver al inicio
          </a>

        </div>

      <% } %>

    </section>

  </main>
<script src="/js/confirmation.js"></script>

</body>

</html>